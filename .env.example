# Optional only. Prefer Settings → Google account in the app UI.
# Credentials are normally saved under Electron userData (never commit them).

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_API_KEY=

# Optional: override userData (default is shared: %APPDATA%\myyoutube for both
# npm run dev and the installed app). Use only for an isolated test profile.
# MYYOUTUBE_USER_DATA=
